{
  "functions": {
    "api/qwen-api/[...path].ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "api/anymail-api/[...path].ts": {
      "maxDuration": 60,
      "memory": 512
    }
  },
  "rewrites": [
    { "source": "/qwen-api/:path*", "destination": "/api/qwen-api/:path*" },
    { "source": "/anymail-api/:path*", "destination": "/api/anymail-api/:path*" }
  ]
}
