{
  "regions": ["hkg1", "sin1"],
  "functions": {
    "api/qwen.ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "api/anymail.ts": {
      "maxDuration": 60,
      "memory": 512
    }
  },
  "rewrites": [
    { "source": "/qwen-api/:path*", "destination": "/api/qwen?__upstream=/:path*" },
    { "source": "/anymail-api/:path*", "destination": "/api/anymail?__upstream=/:path*" },
    { "source": "/api/qwen-api/:path*", "destination": "/api/qwen?__upstream=/:path*" },
    { "source": "/api/anymail-api/:path*", "destination": "/api/anymail?__upstream=/:path*" }
  ]
}
