{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/((?!assets/).*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "functions": {
    "api/qwen.ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "api/anymail.ts": {
      "maxDuration": 180,
      "memory": 512
    },
    "api/hunter.ts": {
      "maxDuration": 30,
      "memory": 256
    },
    "api/anysearch.ts": {
      "maxDuration": 60,
      "memory": 256
    },
    "api/tavily.ts": {
      "maxDuration": 60,
      "memory": 256
    },
    "api/directmail.ts": {
      "maxDuration": 30,
      "memory": 256
    },
    "api/tripo.ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "api/tokenhub.ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "api/social.ts": {
      "maxDuration": 60,
      "memory": 512
    },
    "api/landing.ts": {
      "maxDuration": 60,
      "memory": 512
    }
  },
  "rewrites": [
    { "source": "/qwen-api/:path*", "destination": "/api/qwen?__upstream=/:path*" },
    { "source": "/anymail-api/:path*", "destination": "/api/anymail?__upstream=/:path*" },
    { "source": "/hunter-api/:path*", "destination": "/api/hunter?__upstream=/:path*" },
    { "source": "/anysearch-api/:path*", "destination": "/api/anysearch" },
    { "source": "/tavily-api/:path*", "destination": "/api/tavily?__upstream=/:path*" },
    { "source": "/gemini-api/:path*", "destination": "/api/qwen?__upstream=/:path*" },
    { "source": "/tripo-api/:path*", "destination": "/api/tripo?__upstream=/:path*" },
    { "source": "/tokenhub-api/:path*", "destination": "/api/tokenhub?__upstream=/:path*" },
    { "source": "/linkedin-api/:path*", "destination": "/api/social?__origin=https://api.linkedin.com&__upstream=/:path*" },
    { "source": "/meta-api/:path*", "destination": "/api/social?__origin=https://graph.facebook.com&__upstream=/:path*" },
    { "source": "/x-api/:path*", "destination": "/api/social?__origin=https://api.x.com&__upstream=/:path*" },
    { "source": "/api/qwen-api/:path*", "destination": "/api/qwen?__upstream=/:path*" },
    { "source": "/api/anymail-api/:path*", "destination": "/api/anymail?__upstream=/:path*" },
    { "source": "/api/hunter-api/:path*", "destination": "/api/hunter?__upstream=/:path*" },
    { "source": "/api/anysearch-api/:path*", "destination": "/api/anysearch" },
    { "source": "/api/tavily-api/:path*", "destination": "/api/tavily?__upstream=/:path*" },
    { "source": "/api/tripo-api/:path*", "destination": "/api/tripo?__upstream=/:path*" },
    { "source": "/api/tokenhub-api/:path*", "destination": "/api/tokenhub?__upstream=/:path*" }
  ]
}
