{
  "name": "waimao-zhihui-xietong-desktop",
  "productName": "外贸智慧协同",
  "version": "1.0.0",
  "description": "外贸智慧协同桌面客户端",
  "main": "main.js",
  "author": "外贸智慧协同",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack:seed": "node scripts/pack-seed.mjs",
    "ensure-seed": "node -e \"const fs=require('fs');const {encryptSeed}=require('./lib/seedCrypto');fs.mkdirSync('resources',{recursive:true});if(!fs.existsSync('resources/seed.bin')){fs.writeFileSync('resources/seed.bin',encryptSeed({version:1,createdAt:Date.now(),note:'placeholder',localStorage:{}}));console.log('wrote placeholder seed');}else console.log('seed.bin ok');\"",
    "pack": "npm run ensure-seed && electron-builder --dir",
    "dist": "npm run ensure-seed && electron-builder --mac --win",
    "dist:mac": "npm run ensure-seed && electron-builder --mac",
    "dist:win": "npm run ensure-seed && electron-builder --win"
  },
  "build": {
    "appId": "ltd.babyworld.app",
    "productName": "外贸智慧协同",
    "copyright": "Copyright © 外贸智慧协同",
    "artifactName": "外贸智慧协同-${version}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "lib/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/seed.bin",
        "to": "seed.bin"
      }
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.business",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null
    },
    "dmg": {
      "title": "外贸智慧协同"
    },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "dir",
          "arch": ["x64"]
        }
      ]
    }
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
