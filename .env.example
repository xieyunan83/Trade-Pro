# Supabase（必填 — 云端数据同步）
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key

# 千问 API（国内大模型，推荐）
# Token Plan 示例：
# REACT_APP_QWEN_API_KEY=sk-sp-...
# REACT_APP_QWEN_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# REACT_APP_QWEN_MODEL=qwen3.7-plus
REACT_APP_QWEN_API_KEY=sk-ws-...
REACT_APP_QWEN_BASE_URL=https://ws-xxx.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
REACT_APP_QWEN_MODEL=qwen-plus
REACT_APP_DEFAULT_AI_MODEL=qwen

# 万相图片生成（可与千问共用 Token Plan Key；不填则回退千问配置）
# REACT_APP_WAN_API_KEY=sk-sp-...
# REACT_APP_WAN_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com
# REACT_APP_WAN_MODEL=wan2.7-image-pro
REACT_APP_WAN_API_KEY=
REACT_APP_WAN_BASE_URL=
REACT_APP_WAN_MODEL=wan2.7-image-pro

# Gemini（可选备用）
REACT_APP_GEMINI_API_KEY=

# 其他可选 API
REACT_APP_HUNTER_API_KEY=

# AnySearch（背调身份补全；推荐在管理后台填写并保存到云端，线上自动同步）
# 本地开发可选兜底：
ANYSEARCH_API_KEY=

# 可选：云端 workspace 隔离 ID（与 scripts/supabase-rls-harden.sql 保持一致）
# VITE_WORKSPACE_ID=your-long-random-workspace-id

# 可选：DirectMail 服务端密钥（优先于浏览器表单）
# ALIYUN_DM_ACCESS_KEY_ID=
# ALIYUN_DM_ACCESS_KEY_SECRET=
# ALIYUN_DM_ACCOUNT_NAME=

# —— 升级骨架：数据接入（推荐在管理后台「数据接入」填写并云同步；此处仅文档占位）——
# REACT_APP_TOYSBEAR_API_KEY=
# REACT_APP_TOYSBEAR_API_BASE=
# REACT_APP_SKYBIRD_API_KEY=
# REACT_APP_SKYBIRD_API_BASE=
# REACT_APP_CUSTOMS_API_KEY=
# REACT_APP_CUSTOMS_API_BASE=
# REACT_APP_TRIPO_API_KEY=
# REACT_APP_WAN_VIDEO_MODEL=wan2.6-i2v-flash
# 产品设计 Agent（推荐在管理后台「数据接入 → 设计 Agent」填写）
# REACT_APP_DESIGN_AGENT_API_KEY=
# REACT_APP_DESIGN_AGENT_API_BASE=
# REACT_APP_DESIGN_AGENT_MODEL=wan2.7-image-pro
